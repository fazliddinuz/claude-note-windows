# Serverdagi .env namunasi. HAQIQIY .env git ga TUSHMAYDI.
# Nusxa olib to'ldiring:  cp .env.example .env

# --- majburiy ---------------------------------------------------------------

# Mijozlar (note.py) shu token bilan yuboradi. Vergul bilan bir nechta
# bo'lishi mumkin - odam ketganda uniki alohida o'chiriladi.
#   yangi token:  openssl rand -hex 32
INGEST_TOKENS=

# Dashboard ga kirish paroli
DASHBOARD_PASSWORD=

# --- ixtiyoriy --------------------------------------------------------------

# Cookie imzosi. Bo'sh qoldirilsa /data/secret.key da o'zi yaratiladi.
SECRET_KEY=

# Konteyner localhost da qaysi portda tursin (nginx shu yerga proksi qiladi)
HOST_PORT=8095

# Ma'lum loyihalar. Bu ro'yxatda yo'q loyiha "Бегона лойиҳа" deb belgilanadi.
# Bo'sh qoldirilsa bu ogohlantirish umuman ishlamaydi.
#   masalan: KNOWN_PROJECTS=demo-project,web-shop,mobile-app
KNOWN_PROJECTS=

# Telemetriya ishga tushirilgan kun (YYYY-MM-DD). Undan OLDIN boshlangan
# sessiyalar "tarix" bo'lib alohida turadi va kunlik hisobga qo'shilmaydi -
# ular bir necha hafta davomida yig'ilgan va ko'rsatkichlarni buzadi.
# Bo'sh qoldirilsa hamma narsa bitta hisobda bo'ladi.
HISTORY_BEFORE=

# Tungi ish oralig'i (mijozning mahalliy soati bo'yicha, 24 soatlik)
NIGHT_START=0
NIGHT_END=6

# Ogohlantirish chegaralari
ALERT_SESSION_USD=15
ALERT_DAY_USD=40
ALERT_CONTEXT_TOKENS=150000

# Bitta so'rov tanasining chegarasi (bayt)
MAX_BODY_BYTES=65536
